SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server-only. Never expose with a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=

ROOTED_APP_ORIGIN=https://rooted-audio-test.netlify.app
ROOTED_AUDIO_OWNER_EMAIL=
# Keep this on invite while testing. Change to public only for the approved launch.
ROOTED_REGISTRATION_MODE=invite
ROOTED_TEST_ALLOWED_EMAILS=
ROOTED_TEST_ACCESS_TOKEN=

# Test key remains available for rollback; live key is server-only and production-only.
MOLLIE_API_KEY=test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MOLLIE_LIVE_API_KEY=
MOLLIE_LIVE_ENABLED=false

# No public customer launch until hosted database, payment, account and journey tests pass.


# Enable only after the guest-order migration, paid invite template and disabled public Supabase signup are configured.
ROOTED_PAY_FIRST_ENABLED=false
